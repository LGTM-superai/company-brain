# secrets & local state
.env
.brain/

# python
__pycache__/
*.pyc
.pytest_cache/

# terraform — state can contain plaintext secrets (IAM access keys). Never commit.
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
.terraform.lock.hcl
infra/.docdb_pw
infra/.docdb_uri
infra/global-bundle.pem

# uploaded runtime docs: the local KB backend writes into sample_kb. The 5 fixture
# docs are already tracked (stay in the repo); this ignores everything else uploaded.
infra/sample_kb/md/
infra/.proxy_instance
infra/.proxy_ip
knowledge_graph.html
lib/

.venv/
