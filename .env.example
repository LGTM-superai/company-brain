# MongoDB
MONGODB_URL=
MONGODB_DB_NAME=company_brain

# AI model provider
# Use "bedrock" for the current working setup. Use "vercel-ai-gateway" only
# after the Vercel AI Gateway key/OIDC auth is working.
AI_MODEL_PROVIDER=bedrock

# AI model
# Bedrock mode uses BEDROCK_MODEL_ID first, then AI_MODEL.
# Vercel AI Gateway mode uses AI_GATEWAY_MODEL first, then AI_MODEL.
AI_MODEL=
BEDROCK_MODEL_ID=
AI_GATEWAY_MODEL=
AI_GATEWAY_API_KEY=
VERCEL_AI_GATEWAY_API_KEY=

# AWS (Bedrock + S3 + DocumentDB)
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
KB_S3_BUCKET=

# Notion sprint board
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Notion MCP sidecar
NOTION_MCP_URL=http://127.0.0.1:3333/mcp
NOTION_MCP_AUTH_TOKEN=
NOTION_MCP_HOST=127.0.0.1
NOTION_MCP_PORT=3333

# Exa (web search)
EXA_API_KEY=

# Slack
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_VERIFICATION_TOKEN=
SLACK_BOT_TOKEN=
SLACK_ANNOUNCEMENTS_CHANNEL_ID=
SLACK_ENGINEERING_CHANNEL_ID=
SLACK_VULNERABILITY_MONITORING_CHANNEL_ID=
SLACK_ACTION_CHANNEL_ID=

# Stripe
STRIPE_SECRET_KEY=

# GitHub
GITHUB_TOKEN=

# Vercel
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
