# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.

# ── Model calls ──────────────────────────────────────────────────────────────
BRAIN_MODEL_PROVIDER=bedrock              # bedrock | openai
# Bedrock (default): set a model/inference-profile your AWS account can use.
BRAIN_BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
AWS_REGION_NAME=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=
# OpenAI (only if BRAIN_MODEL_PROVIDER=openai):
# OPENAI_API_KEY=
# BRAIN_AGENT_MODEL=gpt-5-mini

# ── Knowledge base (Amazon DocumentDB catalog + S3 content) ──────────────────
# Unset MONGODB_URI → in-memory mongomock (local dev). Set it for Amazon DocumentDB.
# DocumentDB needs TLS + retryWrites=false and is reachable only inside its VPC.
# MONGODB_URI=mongodb://USER:PASS@CLUSTER-ENDPOINT:27017/?tls=true&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false
# MONGO_TLS_CA_FILE=infra/global-bundle.pem   # Amazon RDS CA bundle (download separately)
BRAIN_DB_NAME=company_brain
KB_BACKEND=local                 # local (files in infra/sample_kb) | s3
# KB_S3_BUCKET=company-brain-lgtm-CHANGEME
# KB_INGEST_ACCESS_KEY_ID=
# KB_INGEST_SECRET_ACCESS_KEY=

# ── Exa (web search) ─────────────────────────────────────────────────────────
EXA_API_KEY=

# ── Slack ────────────────────────────────────────────────────────────────────
# Bot User OAuth Token (scopes: chat:write, chat:write.public, channels:read)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# App-Level Token (xapp-...) for Socket Mode inbound, once that's built:
# SLACK_APP_TOKEN=
