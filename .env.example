# MONGODB_URL=
# MONGODB_DB_NAME=
# Company Brain — local secrets & config. Gitignored. Do not commit.

# ── AWS credentials (long-lived IAM user keys) ───────────────────────────────
AWS_DEFAULT_REGION=
AWS_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Model calls: AWS Bedrock (via LiteLLM) ───────────────────────────────────
BRAIN_MODEL_PROVIDER=
# Primary =
BRAIN_BEDROCK_MODEL=
BRAIN_BEDROCK_FALLBACK_MODEL=

# ── Knowledge base ───────────────────────────────────────────────────────────
# S3 content store on lgtm-app-data-prod (the bedrock-user now has S3 access).
KB_BACKEND=
KB_S3_BUCKET=
# DocumentDB deployed (VPC-only). Uncomment to use it instead of mongomock — only works
# from inside the VPC or via an SSH tunnel/bastion (not from a laptop directly):
MONGODB_URI=
MONGO_TLS_CA_FILE=
# Ingest + reads use the ambient AWS_* creds above (or KB_INGEST_* for split creds).

# ── Exa (web search) ─────────────────────────────────────────────────────────
EXA_API_KEY=

# ── Slack ────────────────────────────────────────────────────────────────────
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_VERIFICATION_TOKEN=
SLACK_BOT_TOKEN=

# ── OpenAI (only if BRAIN_MODEL_PROVIDER=
# OPENAI_API_KEY=

# ── Stripe (payments + Issuing) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=


GITHUB_TOKEN=