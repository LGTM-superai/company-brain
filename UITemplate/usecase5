<script>
        // Auto-expand textarea
        const textarea = document.querySelector('textarea');
        textarea.addEventListener('input', function() {
            this.style.height = 'auto';
            this.style.height = (this.scrollHeight) + 'px';
        });

        // Simple click interaction for sidebar tabs
        const navItems = document.querySelectorAll('aside nav a');
        navItems.forEach(item => {
            item.addEventListener('click', (e) => {
                navItems.forEach(i => {
                    i.classList.remove('text-primary', 'font-bold', 'bg-secondary-container');
                    i.classList.add('text-on-surface-variant');
                });
                item.classList.add('text-primary', 'font-bold', 'bg-secondary-container');
                item.classList.remove('text-on-surface-variant');
            });
        });
    </script>
