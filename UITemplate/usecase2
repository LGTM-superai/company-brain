<!-- UI Logic for subtle interactions -->
<script>
        // Micro-interaction for input focus
        const mainInput = document.querySelector('input[type="text"]:not([placeholder*="Search"])');
        mainInput.addEventListener('focus', () => {
            mainInput.parentElement.classList.add('scale-[1.01]');
            mainInput.parentElement.style.transition = 'transform 0.2s ease-out';
        });
        mainInput.addEventListener('blur', () => {
            mainInput.parentElement.classList.remove('scale-[1.01]');
        });

        // Simulating the "Review Patch" button click with a visual ripple/state
        const reviewBtn = document.querySelector('button:contains("Review Patch")') || document.querySelector('.bg-tertiary');
        if(reviewBtn) {
            reviewBtn.addEventListener('click', () => {
                reviewBtn.innerText = 'Analyzing...';
                reviewBtn.classList.add('opacity-50', 'pointer-events-none');
                setTimeout(() => {
                    reviewBtn.innerText = 'Patch Reviewed';
                    reviewBtn.classList.remove('opacity-50');
                    reviewBtn.classList.add('bg-primary', 'text-on-primary');
                }, 1500);
            });
        }
    </script>


