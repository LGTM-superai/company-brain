{
  "name": "company-brain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.2.19",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --env-file=.env --cwd apps/web dev",
    "dev:food": "cd apps/food-ordering && uvicorn api.app:app --reload",
    "seed": "bun --env-file=.env apps/web/scripts/seed.ts",
    "typecheck": "bun run --cwd apps/web typecheck"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1065.0"
  }
}
